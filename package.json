{
  "name": "dsh-tool-switch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Per-session tool visibility switch for DeepSeek Harness: a button under the composer, grouped tool picker, applied to live sessions.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
