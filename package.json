{
  "name": "dsh-tool-switch",
  "version": "0.2.0",
  "description": "Per-session tool visibility switch for DeepSeek Harness: a button under the composer, grouped tool picker, applied to live sessions.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "tools",
    "plugin"
  ],
  "author": "suqing114 (https://github.com/suqing114)",
  "license": "MIT",
  "homepage": "https://github.com/suqing114/dsh-tool-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suqing114/dsh-tool-switch.git"
  },
  "bugs": {
    "url": "https://github.com/suqing114/dsh-tool-switch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
